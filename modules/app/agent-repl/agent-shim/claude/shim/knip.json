{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.ts",
    "scripts/**/*.mjs",
    "test/**/*.ts",
    "scripts/dist-smoke.ts"
  ],
  "project": [
    "src/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@stryker-mutator/core", "@stryker-mutator/vitest-runner", "c8"],
  "ignoreBinaries": ["go"]
}
