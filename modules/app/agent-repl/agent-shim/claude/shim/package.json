{
  "name": "claude-repl-shim",
  "version": "0.1.0",
  "private": true,
  "description": "Per-session Claude shim: serves shim.v1 over a UDS, writes store.v1, drives the Claude Agent SDK",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "ensure-deps": "npm ls --depth=0 >/dev/null 2>&1 || npm ci",
    "prebuild": "npm run ensure-deps",
    "build": "node build.mjs",
    "pretest": "npm run ensure-deps",
    "test": "vitest run",
    "precoverage": "npm run ensure-deps",
    "coverage": "vitest run --coverage",
    "pretypecheck": "npm run ensure-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "presmoke": "npm run ensure-deps",
    "smoke": "node scripts/run-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
