{
  "name": "claude-repl-shim",
  "version": "0.1.0",
  "private": true,
  "description": "Per-session Claude shim: serves shim.v1 over a UDS, writes store.v1, drives the Claude Agent SDK",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "ensure-deps": "npm ls --depth=0 >/dev/null 2>&1 || npm ci",
    "prebuild": "npm run ensure-deps",
    "build": "node build.mjs",
    "pretest": "../../../bin/background.sh npm run ensure-deps",
    "test": "../../../bin/background.sh vitest run",
    "pretest:integration": "../../../bin/background.sh sh -c 'npm run build && npm run build:lock'",
    "test:integration": "../../../bin/background.sh vitest run --config vitest.integration.config.ts",
    "precoverage": "../../../bin/background.sh npm run ensure-deps",
    "coverage": "../../../bin/background.sh vitest run --coverage",
    "precoverage:verify": "../../../bin/background.sh npm run ensure-deps",
    "coverage:verify": "../../../bin/background.sh node ../../../bin/coverage-honesty.mjs --probe test/api-usage.test.ts=src/api-usage.ts --probe test/service=src/service/server.ts",
    "prelint": "npm run ensure-deps",
    "lint": "eslint .",
    "pretypecheck": "npm run ensure-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "presmoke": "../../../bin/background.sh npm run ensure-deps",
    "smoke": "../../../bin/background.sh node scripts/run-smoke.mjs",
    "build:lock": "cd ../../shim-lock && go build -o ../claude/shim/dist/shim-lock ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "2.1.9",
    "c8": "10.1.3",
    "esbuild": "^0.21.5",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.69.0",
    "vitest": "^2.1.0"
  }
}
