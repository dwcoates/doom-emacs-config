{
  "system": "shim-sidecar",
  "requirements": [
    {
      "id": "go",
      "kind": "program",
      "why": "builds the Go systems (daemon, store, sidecar, shim-lock); Emacs cold start and every deploy run bin/build-frontend.sh",
      "profile": "run",
      "platforms": [
        "darwin",
        "linux"
      ],
      "command": "go",
      "version": {
        "args": [
          "version"
        ],
        "min": "1.24"
      },
      "install": {
        "brew": "go",
        "apt": "golang-go",
        "dnf": "golang",
        "pacman": "go",
        "zypper": "go"
      }
    },
    {
      "id": "launchctl",
      "kind": "program",
      "why": "loads the store and sidecar as launchd user agents",
      "profile": "run",
      "platforms": [
        "darwin"
      ],
      "command": "launchctl",
      "install": {
        "manual": "launchctl ships with macOS."
      }
    },
    {
      "id": "service-shim-claude-sidecar",
      "kind": "service",
      "why": "watches Claude transcripts and spools into the store, kept running by the platform's service manager",
      "profile": "run",
      "platforms": [
        "darwin",
        "linux"
      ],
      "label": "com.agentrepl.shim-claude-sidecar",
      "args": [
        "--store-socket",
        "~/.cache/agent-repl/sock/store.sock",
        "--config-roots",
        "~/.claude,~/.claude-chesscom",
        "--spool-root",
        "/tmp",
        "--state-dir",
        "~/.claude-emacs",
        "--metrics-root",
        "~/.cache/agent-repl/metrics"
      ],
      "log": {
        "stdout": "shim-claude-sidecar.out.log",
        "stderr": "shim-claude-sidecar.err.log"
      },
      "build_target": "sidecar",
      "binary": "shim-claude-sidecar"
    }
  ]
}
