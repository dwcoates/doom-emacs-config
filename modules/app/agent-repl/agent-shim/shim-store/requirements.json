{
  "system": "shim-store",
  "requirements": [
    {
      "id": "go",
      "kind": "program",
      "why": "builds the Go systems (daemon, store, sidecar, shim-lock); Emacs cold start and every deploy run bin/build-frontend.sh",
      "profile": "run",
      "platforms": [
        "darwin",
        "linux"
      ],
      "command": "go",
      "version": {
        "args": [
          "version"
        ],
        "min": "1.24"
      },
      "install": {
        "brew": "go",
        "apt": "golang-go",
        "dnf": "golang",
        "pacman": "go",
        "zypper": "go"
      }
    },
    {
      "id": "launchctl",
      "kind": "program",
      "why": "loads the store and sidecar as launchd user agents",
      "profile": "run",
      "platforms": [
        "darwin"
      ],
      "command": "launchctl",
      "install": {
        "manual": "launchctl ships with macOS."
      }
    },
    {
      "id": "service-shim-store",
      "kind": "service",
      "why": "the event store every shim and the daemon write through, kept running by the platform's service manager",
      "profile": "run",
      "platforms": [
        "darwin",
        "linux"
      ],
      "label": "com.agentrepl.shim-store",
      "args": [
        "--socket",
        "~/.cache/agent-repl/sock/store.sock",
        "--db",
        "~/.cache/agent-repl/store/events.db",
        "--metrics-root",
        "~/.cache/agent-repl/metrics"
      ],
      "log": {
        "stdout": "shim-store.out.log",
        "stderr": "shim-store.err.log"
      },
      "build_target": "store",
      "binary": "shim-store"
    }
  ]
}
