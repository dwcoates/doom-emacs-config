{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "dist",
    // rootDir spans agent-repl/ so the committed protobuf TS stubs at
    // proto/gen/ts (imported relatively by src/uds and src/proto) are legal
    // program inputs. The stubs live outside this package by design (one
    // generated set shared by claude-shim + webapp), so a src-only rootDir
    // rejects them (TS6059). Emit layout shifts accordingly; the runtime
    // build wiring (main.ts entry, dist path) is a stitch-phase concern.
    "rootDir": "../..",
    "baseUrl": ".",
    // The generated stubs import @bufbuild/protobuf and its subpath exports.
    // They resolve those from THIS package's node_modules, but NodeNext walks
    // up from the stub's own directory (proto/gen/ts) where no node_modules
    // exists, so map the subpaths explicitly to the installed ESM typings.
    "paths": {
      "@bufbuild/protobuf": ["./node_modules/@bufbuild/protobuf/dist/esm/index.d.ts"],
      "@bufbuild/protobuf/codegenv2": ["./node_modules/@bufbuild/protobuf/dist/esm/codegenv2/index.d.ts"],
      "@bufbuild/protobuf/wkt": ["./node_modules/@bufbuild/protobuf/dist/esm/wkt/index.d.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // test/ is in the program too: vitest transpiles without typechecking, so
  // leaving the suites out meant `npm run typecheck` never saw them AND an
  // editor's language server fell back to an inferred config with no `paths`
  // mapping -- which resolves @bufbuild/protobuf twice and degrades
  // MessageShape<Desc> inference to the bare `Message | Message<string>`
  // constraint, producing phantom property-access errors on framed messages.
  "include": ["src/**/*.ts", "test/**/*.ts", "../../proto/gen/ts/**/*.ts"]
}
