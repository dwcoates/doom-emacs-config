{
  "system": "metrics",
  "about": "The always-on metrics store: VictoriaMetrics scraping the daemon, the store and the sidecar (docs/PLAN-runtime-metrics.md).",
  "requirements": [
    {
      "id": "victoria-metrics",
      "kind": "program",
      "why": "stores 30 days of agent-repl's runtime metrics for agents to query (the agent-repl-metrics skill)",
      "profile": "run",
      "platforms": [
        "darwin"
      ],
      "command": "victoria-metrics",
      "install": {
        "brew": "victoriametrics"
      }
    },
    {
      "id": "service-victoriametrics",
      "kind": "service",
      "why": "keeps VictoriaMetrics scraping every 15 seconds, kept running by the platform's service manager",
      "profile": "run",
      "platforms": [
        "darwin",
        "linux"
      ],
      "label": "com.agentrepl.victoriametrics",
      "args": [
        "-storageDataPath=~/.cache/agent-repl/metrics/data",
        "-retentionPeriod=30d",
        "-httpListenAddr=127.0.0.1:8428",
        "-promscrape.config=~/.cache/agent-repl/metrics/scrape.yml",
        "-promscrape.fileSDCheckInterval=15s",
        "-search.latencyOffset=5s"
      ],
      "env": {
        "AGENT_REPL_METRICS_ROOT": "~/.cache/agent-repl/metrics"
      },
      "log": {
        "stdout": "victoriametrics.log",
        "stderr": "victoriametrics.log"
      },
      "command": "victoria-metrics",
      "files": [
        {
          "from": "metrics/scrape.yml",
          "to": "metrics/scrape.yml"
        },
        {
          "from": "metrics/store.json",
          "to": "metrics/store.json"
        }
      ]
    }
  ]
}
