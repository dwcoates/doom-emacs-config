# Codegen for the agent-shim protobuf protocol.
#
# Outputs:
#   Go  → gen/go/...   (consumed by daemon/, agent-shim/shim-store/, agent-shim/claude/shim-sidecar/)
#   TS  → gen/ts/...   (consumed by agent-shim/claude/shim/, webapp/)
#
# Requires: protoc, protoc-gen-go, protoc-gen-connect-go (Connect service
# handler interfaces — message types alone cannot serve an rpc), and
# @bufbuild/protoc-gen-es (via npx).
#
# GENERATOR VERSION PINS. An unpinned `npx @bufbuild/protoc-gen-es` fetches
# whatever is latest on the day the Makefile runs, which regenerates the
# entire committed gen/ts tree out from under an unrelated change the moment a
# new release ships. PROTOC_GEN_ES_VERSION below is the exact version the
# committed gen/ts tree was generated with (read off any file's
# "@generated by protoc-gen-es vX.Y.Z" header), and both npx invocations in
# the `ts` target pin to it. `check-gen-version` (a prerequisite of `lint`)
# fails loudly if the committed headers ever disagree with this pin.
#
# protoc-gen-go and protoc-gen-connect-go are plain Go binaries resolved off
# PATH rather than fetched per-invocation, so there is no npx-style pin site
# in this Makefile for them. PROTOC_GEN_GO_VERSION documents the version the
# committed gen/go tree was generated with (also readable off any .pb.go
# file's "protoc-gen-go vX.Y.Z" header, which check-gen-version also checks),
# and PROTOC_GEN_CONNECT_GO_VERSION documents protoc-gen-connect-go's pin.
# It emits no version header, so nothing can gate on it directly; installing
# it from the exact pinned version below and relying on `check-generated`
# (byte-for-byte diff of a fresh regen against the committed tree) is what
# catches drift there. To install the pinned Go generators:
#
#   go install google.golang.org/protobuf/cmd/protoc-gen-go@v$(PROTOC_GEN_GO_VERSION)
#   go install connectrpc.com/connect/cmd/protoc-gen-connect-go@v$(PROTOC_GEN_CONNECT_GO_VERSION)
#
# UPGRADE PROCEDURE (any of the three generators). Bump the relevant
# *_VERSION variable below, install/use the new generator version, run
# `make all` to regenerate, and commit the version bump together with the
# regenerated gen/ tree in one commit. Never let the pin and the generated
# bytes drift apart across commits.
PROTOC_GEN_ES_VERSION := 2.14.1
PROTOC_GEN_GO_VERSION := 1.36.11
PROTOC_GEN_CONNECT_GO_VERSION := 1.17.0

# The proto set is DISCOVERED from src/ so the Makefile can never hold a
# stale hand-maintained list: every .proto under the six surface roots is
# compiled, and a deleted file leaves the build the moment it leaves disk.
#
# EACH ROOT IS TESTED BEFORE IT IS SEARCHED, which is what keeps the discovery
# QUIET where there is nothing to discover: scripts/test-check-generated.sh
# drives these same targets against a FIXTURE tree that carries a src/ without
# the surface roots under it, and the unguarded `find` reported one "No such
# file or directory" per root on every such run. The set comes out identical in
# the real tree; the guard only stops the empty case from saying so.
PROTOS := $(shell cd src 2>/dev/null && for root in conversation frontend agentrepl workspace shim store; do \
	  [ -d "$$root" ] && find "$$root" -name '*.proto'; \
	done | sort)

# The component tree the structural gates scan. Overridable so the gate
# self-tests can drive the REAL targets against a fixture tree; the default is
# the schema tree this Makefile generates from.
COMPONENT_DIR ?= src/frontend/v1
# The tree I7 scans for forbidden imports. Overridable so the codegen-gate
# self-test can point it at its own fixture root.
ISOLATION_ROOT ?= ..

.PHONY: all go ts lint codegen-gate conversation-isolation check-gen-version test-check-conversation-isolation test-check-generated check-generated validate coverage clean

all: go ts

# EVERY path that emits bindings passes through this target. The structural
# invariants below are not review notes, they are preconditions on codegen: a
# schema that has already drifted must not be able to produce bindings by any
# Makefile route, so `go`, `ts`, `all`, and `lint` all depend on this rather
# than on `lint` alone. New structural gates are added here, once.
codegen-gate: conversation-isolation

go: codegen-gate
	mkdir -p gen/go
	protoc -I src --go_out=gen/go --go_opt=paths=source_relative \
	  --connect-go_out=gen/go --connect-go_opt=paths=source_relative $(PROTOS)

ts: codegen-gate
	mkdir -p gen/ts
	npx --yes @bufbuild/protoc-gen-es@$(PROTOC_GEN_ES_VERSION) --version >/dev/null
	protoc -I src \
	  --plugin=protoc-gen-es=$$(npx --yes --package=@bufbuild/protoc-gen-es@$(PROTOC_GEN_ES_VERSION) which protoc-gen-es 2>/dev/null || echo ./node_modules/.bin/protoc-gen-es) \
	  --es_out=gen/ts --es_opt=target=ts $(PROTOS)

# Syntax-check every proto without emitting code, then enforce the structural
# invariants the syntax check cannot see.
lint: codegen-gate check-gen-version
	protoc -I src --descriptor_set_out=/dev/null $(PROTOS)

# Fails loudly when the version embedded in the committed generated headers
# disagrees with the pin above. The failure mode this exists for is an
# unpinned generator silently regenerating the tree with a newer release (see
# the GENERATOR VERSION PINS note at the top of this file). protoc-gen-connect-go
# emits no version header, so it is not checked here; check-generated's
# byte-for-byte diff is what catches drift from that generator.
check-gen-version:
	@test -d gen/ts && test -d gen/go || { echo "check-gen-version: gen/ts or gen/go is missing; run 'make all' first" >&2; exit 1; }
	@es_versions="$$(grep -rho '@generated by protoc-gen-es v[0-9][0-9.]*' gen/ts | sed 's/.*v//' | sort -u)"; \
	if [ -z "$$es_versions" ]; then \
	  echo "check-gen-version: no protoc-gen-es header found under gen/ts" >&2; exit 1; \
	elif [ "$$es_versions" != "$(PROTOC_GEN_ES_VERSION)" ]; then \
	  echo "check-gen-version: gen/ts carries protoc-gen-es header version(s) [$$es_versions] but the Makefile pins $(PROTOC_GEN_ES_VERSION); either regenerate with the pinned version and commit the diff, or bump PROTOC_GEN_ES_VERSION deliberately and regenerate" >&2; \
	  exit 1; \
	fi
	@go_versions="$$(grep -rho 'protoc-gen-go v[0-9][0-9.]*' gen/go | sed 's/.*v//' | sort -u)"; \
	if [ -z "$$go_versions" ]; then \
	  echo "check-gen-version: no protoc-gen-go header found under gen/go" >&2; exit 1; \
	elif [ "$$go_versions" != "$(PROTOC_GEN_GO_VERSION)" ]; then \
	  echo "check-gen-version: gen/go carries protoc-gen-go header version(s) [$$go_versions] but the Makefile pins $(PROTOC_GEN_GO_VERSION); either regenerate with the pinned version and commit the diff, or bump PROTOC_GEN_GO_VERSION deliberately and regenerate" >&2; \
	  exit 1; \
	fi

# INVARIANT I6 IS GONE, AND ITS GATE WITH IT. `durable.proto` needed a script
# only while it sat INSIDE frontend/v1 being definitionally not frontend, so the
# one thing separating persistence evidence from the push surface was a grep.
# It is now `state.v1`, its own package, its own Go import path and its own TS
# module — the compiler enforces what the script used to check.

# INVARIANT I7. store.v1 is the half of a stored record that never crosses
# the shim wire — the observation plane, the store's dedup key, and anything the
# producer could not convert. No daemon or webapp source may import it. It is a
# separate PACKAGE rather than a separate file precisely so the boundary is a Go
# import path and a TS module rather than a convention; this gate refuses the one
# remaining way to cross it.
conversation-isolation:
	./scripts/check-conversation-isolation.sh $(ISOLATION_ROOT)

test-check-conversation-isolation:
	./scripts/test-check-conversation-isolation.sh

# Regenerate and compare with the exact pre-generation bytes. Comparing with
# HEAD rejects a correct uncommitted schema edit, which makes the pre-commit
# validation gate impossible to satisfy.
check-generated:
	test -d gen
	@before="$$(mktemp -d "$${TMPDIR:-/tmp}/agent-repl-proto-gen.XXXXXX")"; \
	trap 'rm -rf "$$before"' EXIT; \
	cp -R gen/. "$$before"/; \
	$(MAKE) all; \
	diff -ru "$$before" gen

test-check-generated:
	./scripts/test-check-generated.sh

# Validate both the source schema and the checked-in Go/TS generated artifacts.
validate: lint test-check-conversation-isolation test-check-generated check-generated

# Generated stubs are dependencies, not coverage subjects.  Each consumer's
# own coverage configuration scopes measurement to handwritten package source.
#
# THE COMPONENT LIST LIVES IN bin/report-nonlisp-coverage.sh ALONE.  With no
# arguments it runs every default component, and its `proto` component is this
# Makefile's `validate`, run first.  A list restated here drifted: it kept
# naming `wire` after that module was deleted, and the script refused it.
coverage:
	../bin/report-nonlisp-coverage.sh

clean:
	rm -rf gen
