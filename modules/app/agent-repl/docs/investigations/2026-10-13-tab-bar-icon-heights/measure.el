;;; measure.el --- measure each tab-bar icon's largest size that keeps the row height  -*- lexical-binding: t -*-
;; Run in a WINDOWED Emacs: Emacs -Q -l measure.el. Writes $TABICONS_OUT and exits, always.
(require 'cl-lib)
(defvar ti-out (getenv "TABICONS_OUT"))
(defvar ti-font (or (getenv "TABICONS_FONT") "Menlo-13"))
(defvar ti-glyphs '(("❄️" . "cold gate") ("🎯" . "one-shot") ("❗" . "permission") ("❓" . "question")
                    ("●" . "dot/attention") ("≡" . "failed merge")))
(defvar ti-item "x")
(defun ti-format () `((ti menu-item ,ti-item ignore)))
(defun ti-tab (str)
  "Row height of a tab bar showing STR."
  (setq ti-item (concat "[1] " str " name"))
  (force-mode-line-update t) (redisplay t)
  (tab-bar-height nil t))
(defun ti-line (str)
  "(LINE-HEIGHT FAMILY SIZE) of a buffer line showing STR, and the font drawing STR."
  (with-current-buffer (get-buffer-create "*ti*")
    (erase-buffer) (insert "[1] " str " name")
    (set-window-buffer (selected-window) (current-buffer))
    (redisplay t)
    (goto-char (point-min))
    (let ((f (font-at 4 (selected-window))))
      (list (line-pixel-height) (and f (font-get f :family)) (and f (font-get f :size))))))
(defun ti-glyph (g px r)
  (propertize g 'face `(:height ,(* 10 px)) 'display (if (zerop r) nil `(raise ,r))))
(defun ti-run ()
  (let (lines)
    (condition-case err
        (progn
          (set-frame-font ti-font nil t)
          (setq tab-bar-format '(ti-format))
          (tab-bar-mode 1)
          (let ((tab0 (ti-tab "")) (line0 (car (ti-line ""))))
            (push (format "font=%s plain: tab-row=%d buffer-line=%d" ti-font tab0 line0) lines)
            (dolist (g ti-glyphs)
              (push (format "%s %s: drawn-by=%S" (car g) (cdr g) (cdr (ti-line (ti-glyph (car g) 8 0)))) lines)
              (push (concat "   px:tab/line  "
                            (mapconcat (lambda (px) (format "%d:%d/%d" px (ti-tab (ti-glyph (car g) px 0))
                                                            (car (ti-line (ti-glyph (car g) px 0)))))
                                       (number-sequence 6 13) " "))
                    lines)
              (push (concat "   raise@9px tab/line  "
                            (mapconcat (lambda (r) (format "%s:%d/%d" r (ti-tab (ti-glyph (car g) 9 r))
                                                           (car (ti-line (ti-glyph (car g) 9 r)))))
                                       '(0 0.05 0.07 0.1 0.15) " "))
                    lines))))
      (error (push (format "ERROR: %S" err) lines)))
    (with-temp-file ti-out (insert (mapconcat #'identity (nreverse lines) "\n") "\n"))
    (kill-emacs 0)))
(run-at-time 60 nil (lambda () (kill-emacs 1)))
(add-hook 'window-setup-hook (lambda () (run-at-time 0.5 nil #'ti-run)))
