{
  "name": "claude-repl-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Connect (protobuf-es) SPA client for claude-repld",
  "type": "module",
  "scripts": {
    "ensure-deps": "../bin/ensure-deps.sh",
    "dev": "vite",
    "prebuild": "npm run ensure-deps",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "pretest": "../bin/background.sh npm run ensure-deps",
    "test": "../bin/background.sh vitest run",
    "precoverage": "../bin/background.sh npm run ensure-deps",
    "coverage": "../bin/background.sh vitest run --coverage --isolate",
    "precoverage:verify": "../bin/background.sh npm run ensure-deps",
    "coverage:verify": "../bin/background.sh node ../bin/coverage-honesty.mjs --probe test/scroll.test.ts=src/scroll.ts --probe test/feed/cards/hook.test.ts=src/feed/cards/hook.ts",
    "prelint": "npm run ensure-deps",
    "lint": "eslint .",
    "pretypecheck": "npm run ensure-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:integration": "../bin/background.sh npm run ensure-deps",
    "test:integration": "../bin/background.sh vitest run -c vitest.integration.config.ts",
    "pretest:webkit": "../bin/background.sh npm run ensure-deps",
    "test:webkit": "../bin/background.sh vitest run -c vitest.webkit.config.ts",
    "test:webapp-layer": "../bin/background.sh vitest run -c vitest.webapp-layer.config.ts"
  },
  "devDependencies": {
    "@connectrpc/connect-node": "^2.1.2",
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.0",
    "@vitest/coverage-istanbul": "2.1.9",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "^29.1.1",
    "playwright-core": "1.48.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.69.0",
    "undici": "^7.28.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-task-lists": "^2.1.1"
  }
}
