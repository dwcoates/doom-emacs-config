{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@bufbuild/protobuf": ["node_modules/@bufbuild/protobuf/dist/esm/index.d.ts"],
      "@bufbuild/protobuf/codegenv2": ["node_modules/@bufbuild/protobuf/dist/esm/codegenv2/index.d.ts"],
      "@bufbuild/protobuf/reflect": ["node_modules/@bufbuild/protobuf/dist/esm/reflect/index.d.ts"],
      "@bufbuild/protobuf/wire": ["node_modules/@bufbuild/protobuf/dist/esm/wire/index.d.ts"],
      "@bufbuild/protobuf/wkt": ["node_modules/@bufbuild/protobuf/dist/esm/wkt/index.d.ts"]
    },
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  // The integration suite compiles WITH everything else: its harness mounts
  // every component through that component's own published signature, so a
  // renamed mount, a changed deps object or a dropped DOM hook fails the
  // typecheck rather than waiting for a slow suite to notice at runtime.
  "exclude": ["node_modules", "dist"]
}
