<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.agentrepl.shim-store — launchd user agent for the shim-store service.
  The binding design is docs/overhaul/store.md (store.v1 served with Connect
  over a UNIX domain socket; there is deliberately no health verb — the
  doctor probes the Connect endpoints directly).

  TEMPLATE: this checked-in copy uses ~-relative paths so it reads portably
  and resolves on any machine. launchd does NOT expand `~`, so
  .claude/install.sh (install_agent_shim_services) rewrites every leading `~/`
  to the invoking user's absolute $HOME when copying this file into
  ~/Library/LaunchAgents/. Do not load this template file directly.

  Flag contract (must match agent-shim/shim-store/main.go):
    --socket  Connect-over-UDS server path (~/.cache/agent-repl/sock/store.sock)
    --db      SQLite/WAL event db          (~/.cache/agent-repl/store/events.db)

  Nothing else is passed: --log, --pprof and --watch-buffer keep their
  defaults, and this service needs no other flag.

  AGENT_REPL_STORE_SOCKET is the TEST-ONLY override of the --socket default
  (an explicit --socket always beats it). It is deliberately NOT set here:
  the OS-managed service is pinned to the real socket path by the explicit
  --socket argument above, so no environment can move it.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentrepl.shim-store</string>

    <key>ProgramArguments</key>
    <array>
        <string>~/.cache/agent-repl/bin/shim-store</string>
        <string>--socket</string>
        <string>~/.cache/agent-repl/sock/store.sock</string>
        <string>--db</string>
        <string>~/.cache/agent-repl/store/events.db</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Do not respawn faster than once per 10s if the binary crash-loops. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!--
      A STOP THAT IS ASKED FOR IS A STOP THAT HAPPENS. Stated explicitly rather
      than left to launchd's default, because a stop this service did not
      complete is what made this key necessary: one teardown held past three
      minutes while launchd waited, and `bin/store-reset.sh` waited with it. The
      service's own shutdown is bounded well inside this (see
      logging.DefaultShutdownDrain, 5s), so reaching this timeout means the
      process is stuck somewhere it has no bound of its own and SIGKILL is the
      right answer.
    -->
    <key>ExitTimeOut</key>
    <integer>20</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>~/.cache/agent-repl/log/shim-store.out.log</string>

    <key>StandardErrorPath</key>
    <string>~/.cache/agent-repl/log/shim-store.err.log</string>
</dict>
</plist>
