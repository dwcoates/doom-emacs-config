{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "tldr_prompt",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "preamble"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "section"
          }
        }
      ]
    },
    "preamble": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_line"
      }
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "heading"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_line"
          }
        }
      ]
    },
    "heading": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "heading_label"
          },
          "named": true,
          "value": "label"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "separator"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "marker"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "branch"
        },
        {
          "type": "SYMBOL",
          "name": "continuation"
        },
        {
          "type": "SYMBOL",
          "name": "fence"
        },
        {
          "type": "SYMBOL",
          "name": "prose"
        },
        {
          "type": "SYMBOL",
          "name": "blank"
        }
      ]
    },
    "branch": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "prefix"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "ALIAS",
              "content": {
                "type": "SYMBOL",
                "name": "branch_label"
              },
              "named": true,
              "value": "label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "prefix": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "SEQ",
          "members": [
            {
              "type": "PATTERN",
              "value": "[ \\t│|]*"
            },
            {
              "type": "PATTERN",
              "value": "(├──|└──|\\|--|\\+--|`--)"
            },
            {
              "type": "PATTERN",
              "value": "[ \\t]?"
            }
          ]
        }
      }
    },
    "continuation": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "rails"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "rails": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t│]+"
        }
      }
    },
    "fence": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "fence_open"
          },
          {
            "type": "SYMBOL",
            "name": "_line_end"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "fence_line"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "_line_end"
                    }
                  ]
                },
                {
                  "type": "SYMBOL",
                  "name": "_fence_blank"
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "fence_close"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "_line_end"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_fence_blank": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 6,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*\\n"
        }
      }
    },
    "fence_open": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 4,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t│]*```[^\\n]*"
        }
      }
    },
    "fence_close": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 7,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t│]*```[ \\t]*"
        }
      }
    },
    "fence_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 6,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+"
        }
      }
    },
    "separator": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*[-–—:]"
        }
      }
    },
    "marker": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*[←-􏿿](️|‍[←-􏿿]️?|[🏻-🏿])*",
          "flags": "u"
        }
      }
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 0,
        "content": {
          "type": "PATTERN",
          "value": "[^\\n]+"
        }
      }
    },
    "prose": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PREC",
              "value": -1,
              "content": {
                "type": "PATTERN",
                "value": "[^\\n]+"
              }
            }
          },
          "named": true,
          "value": "text"
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "blank": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[ \\t]*\\n"
        }
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "heading_label"
    },
    {
      "type": "SYMBOL",
      "name": "branch_label"
    },
    {
      "type": "SYMBOL",
      "name": "_line_end"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}