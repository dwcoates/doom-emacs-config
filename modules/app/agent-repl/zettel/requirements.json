{
  "system": "zettel",
  "requirements": [
    {
      "id": "service-zettel",
      "kind": "service",
      "why": "the knowledge-graph service the daemon records every chat thread's questions and answers in, kept running by the platform's service manager",
      "profile": "run",
      "platforms": [
        "darwin",
        "linux"
      ],
      "label": "com.agentrepl.zettel",
      "args": [
        "--socket",
        "~/.cache/agent-repl/sock/zettel.sock",
        "--db",
        "~/zettel/zettel.db",
        "--log",
        "~/.cache/agent-repl/log/zettel.log"
      ],
      "log": {
        "stdout": "zettel.out.log",
        "stderr": "zettel.err.log"
      },
      "build_target": "zettel",
      "binary": "zettel"
    }
  ]
}
