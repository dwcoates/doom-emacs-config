# Pinned identifiers for the agent-repl e2e sandbox image.
#
# These are the things the Dockerfile CANNOT pin from a bare checkout,
# because each one needs either a registry or an actual download to resolve
# (see the Dockerfile's pinning comment). They are resolved once, from a real
# build, and recorded here so `e2e-sandbox.sh build` needs no
# `--allow-unpinned`. The gate itself is UNCHANGED: an unset value is still a
# refusal to build, and an environment variable of the same name still wins
# over the value here, so overriding a pin stays deliberate and visible.
#
# Resolved 2026-09-03 from a successful build on this host.
#
# EMACS IS BUILT FROM SOURCE at SANDBOX_EMACS_REF, not installed from apt.
# The webapp panel is an `xwidget-webkit` webview and NO Debian Emacs is
# built with xwidgets (`emacs-nox` has no GUI; `emacs-gtk` is built
# --without-xwidgets), so a distro package cannot run the thing under test.
# Building from the host's own commit also settles the version floor that
# made bookworm's 28.2 unusable (the pinned Doom needs >=29.1 interactive).
#
# THE BASE AND THE SNAPSHOT STAMP ARE BOTH PINNED TO SEPTEMBER 2023, AND
# WEBKITGTK IS THE ONLY REASON. Emacs 30.2's configure requires
# `webkit2gtk-4.1 >= 2.12` AND `< 2.41.92` for xwidgets; every current Debian
# is above that ceiling (trixie ships 2.5x, and bookworm's own security
# updates went 2.40 -> 2.42.1 in Oct 2023 -> 2.50). 20230910 is the NEWEST
# package set whose WebKitGTK still satisfies it, at 2.40.5, and the base is
# the matching dated `bookworm-*-slim` tag so the two agree.
#
# Cost, stated plainly: this package set carries no security updates after
# September 2023. It is a deliberate trade for a `--network none` test
# sandbox, and no newer stamp can avoid it without giving up xwidgets — the
# two constraints are directly opposed.
#
# The Node and Go tarball checksums are unaffected by the base (they are
# upstream tarballs, not Debian packages).
#
# How each was obtained, so the next bump is mechanical:
#   SANDBOX_BASE_IMAGE   docker pull debian:bookworm-20230904-slim &&
#                        docker image inspect --format '{{index .RepoDigests 0}}'
#                        (the multi-arch manifest digest: same value on amd64
#                        and arm64, which is why it needs no per-arch split)
#   NODE_SHA256_*        https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt
#   GO_SHA256_*          https://go.dev/dl/?mode=json&include=all
#   SANDBOX_EMACS_REF    the commit the HOST's Emacs was built from, read
#                        straight out of that Emacs: its `emacs-version` /
#                        `emacs-repository-version` (M-x emacs-version shows
#                        it as "Development version <sha> on HEAD branch")
#   SANDBOX_DOOM_REF     git ls-remote https://github.com/doomemacs/doomemacs master
#
# The tarball checksums are PER ARCHITECTURE — one digest cannot cover both —
# so both are recorded and e2e-sandbox.sh selects the one matching the build
# host. A checksum that is recorded is VERIFIED by the build; the Dockerfile
# still warns loudly on stderr for any that is empty.

SANDBOX_BASE_IMAGE=debian@sha256:050f00e86cc4d928b21de66096126fac52c2ea47885c232932b2e4c00f0c116d

SANDBOX_NODE_VERSION=22.14.0
NODE_SHA256_amd64=69b09dba5c8dcb05c4e4273a4340db1005abeafe3927efda2bc5b249e80437ec
NODE_SHA256_arm64=08bfbf538bad0e8cbb0269f0173cca28d705874a67a22f60b57d99dc99e30050

SANDBOX_GO_VERSION=1.24.6
GO_SHA256_amd64=bbca37cc395c974ffa4893ee35819ad23ebb27426df87af92e93a9ec66ef8712
GO_SHA256_arm64=124ea6033a8bf98aa9fbab53e58d134905262d45a022af3a90b73320f3c3afd5

# Emacs 30.2, "Development version 636f166cfc86 on HEAD branch" — the exact
# commit the host's Emacs is built from.
SANDBOX_EMACS_REF=636f166cfc86

SANDBOX_DOOM_REF=bd38d60b0179dea62cae63ea2cccf376ef65f11f

# Must be >= SANDBOX_BASE_IMAGE's build date; see the Dockerfile comment.
SANDBOX_SNAPSHOT_STAMP=20230910T000000Z
