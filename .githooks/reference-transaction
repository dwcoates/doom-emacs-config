#!/usr/bin/env bash
# reference-transaction — the one place that sees every ref git moves.
#
# Git runs this hook for every ref transaction, once per phase, with the phase
# as its argument and one "<old> <new> <ref>" line per ref on stdin. It sees
# every way a ref can move: a commit, a merge (fast-forward or not), a rebase,
# a cherry-pick, a reset, a pull, `branch -f`, `tag`, `update-ref`, a deletion.
# A pre-commit or pre-merge-commit hook would miss the fast-forward, which runs
# no other hook at all. It does two jobs, one per phase.
#
# 1. PREPARED: master moves only through the agent-repl merge queue. In this
#    phase a nonzero exit aborts the whole transaction.
#    THE RULE, when the repository enforces it:
#      - A transaction that moves refs/heads/master is refused unless the merge
#        queue made it. The queue's fast-forward (daemon/internal/gitclient
#        FastForward) runs git with AGENT_REPL_MERGE_QUEUE=1; nothing else sets it.
#      - AGENT_REPL_OWNER_OVERRIDE=1 is the owner's escape hatch: the move goes
#        through, and the hook says it bypassed the queue.
#      - Every other ref (another branch, HEAD itself, ORIG_HEAD, AUTO_MERGE) is
#        never refused.
#    ENFORCEMENT IS OFF BY DEFAULT. The guard does nothing, silently, unless the
#    repository opts in:
#      git config agentrepl.mergeQueueEnforce true
#    The key is read from the repository the hook runs in, so a repository that
#    inherits this hooks directory without setting the key is untouched too.
#
# 2. COMMITTED: the journal .claude/safe-test-run.sh judges a test run by. A
#    run registers itself as <git-common-dir>/agent-repl-safe-test-runs/<id>/,
#    one mkdir, where <id> ends in "-<pid>": the pid of the safe-test-run.sh
#    that registered it, its root. Every ref this transaction moved is appended
#    to that run's `journal` when the git moving it belongs to the run: its
#    environment carries AGENT_REPL_SAFE_TEST_RUN=<id> (the run exports it to
#    the command it wraps), or the run's root is one of its ancestors (which no
#    environment scrubbing removes). A git no run owns, another session's, is never
#    journaled, so a concurrent session's commits, rebases and new branches can
#    never count against a run. The committed phase cannot refuse anything; git
#    ignores its status. With no run registered the job is one rev-parse.
#
# Installed through `git config core.hooksPath .githooks`, like pre-commit, or
# as a copy in the repository's hooks directory (requirements.json
# reference-transaction-hook).
# AGENT_REPL_MANAGED_HOOK: agent-repl-merge-queue-guard
set -euo pipefail

readonly PROTECTED_REF="refs/heads/master"
readonly ENFORCE_KEY="agentrepl.mergeQueueEnforce"
readonly QUEUE_MARKER="AGENT_REPL_MERGE_QUEUE"
readonly OWNER_OVERRIDE="AGENT_REPL_OWNER_OVERRIDE"
readonly SKILL="modules/app/agent-repl/skills/agent-repl-merge-queue/SKILL.md"
readonly RUN_REGISTRY="agent-repl-safe-test-runs"
readonly RUN_MARKER="AGENT_REPL_SAFE_TEST_RUN"

# ancestors prints this hook's pid and every ancestor's, nearest first, from
# one process listing.
ancestors() {
  ps -A -o pid= -o ppid= | awk -v start="$$" '
    { parent[$1] = $2 }
    END { p = start; for (n = 0; p > 1 && n < NR; n++) { print p; p = parent[p] } }'
}

# journal_test_runs appends TX's refs to the journal of every registered
# safe-test-run the git running this hook belongs to (see 2. above).
journal_test_runs() {
  local registry run id by chain="" root old new ref
  registry="$(git rev-parse --path-format=absolute --git-common-dir)/$RUN_REGISTRY"
  [ -d "$registry" ] || return 0
  for run in "$registry"/*; do
    [ -d "$run" ] || continue
    id="${run##*/}"
    if [ "${!RUN_MARKER:-}" = "$id" ]; then
      by=marker
    else
      root="${id##*-}"
      case "$root" in
        '' | *[!0-9]*)
          echo "[safe-test-run] reference-transaction: the registered run $run does not end in -<pid>; only safe-test-run.sh registers runs, so this is a bug. The refs below went unjudged by it:" >&2
          printf '%s\n' "$TX" | sed 's/^/[safe-test-run]   /' >&2
          exit 1
          ;;
      esac
      [ -n "$chain" ] || chain="$(ancestors)"
      grep -qxF -- "$root" <<<"$chain" || continue
      by=ancestry
    fi
    while read -r old new ref; do
      [ -n "$ref" ] || continue
      printf '%s %s %s pid=%s by=%s cwd=%s\n' "$old" "$new" "$ref" "$PPID" "$by" "$PWD" >>"$run/journal"
    done <<<"$TX"
  done
}

# Both jobs read the same transaction, so it is read once.
TX="$(cat)"

case "${1:-}" in
  committed) journal_test_runs; exit 0 ;;
  prepared) ;;
  *) exit 0 ;;
esac

moves_master=0
while read -r old new ref; do
  if [ "$ref" = "$PROTECTED_REF" ] && [ "$old" != "$new" ]; then
    moves_master=1
  fi
done <<<"$TX"
[ "$moves_master" -eq 1 ] || exit 0

# `git config --get` exits 1 for an unset key, which is enforcement off. Any
# other failure is a value git cannot read as a boolean, and a guard whose
# switch is unreadable refuses rather than guessing which way it was meant.
set +e
enforce="$(git config --type=bool --get "$ENFORCE_KEY" 2>&1)"
status=$?
set -e
case "$status" in
  0) ;;
  1) exit 0 ;;
  *)
    echo "[merge-queue] $ENFORCE_KEY is set but unreadable ($enforce); refusing to move master." >&2
    echo "[merge-queue] Set it to true or false: git config $ENFORCE_KEY false" >&2
    exit 1
    ;;
esac
[ "$enforce" = "true" ] || exit 0

if [ "${!QUEUE_MARKER:-}" = "1" ]; then
  exit 0
fi

if [ "${!OWNER_OVERRIDE:-}" = "1" ]; then
  echo "[merge-queue] $OWNER_OVERRIDE=1: master moved by hand, BYPASSING the merge queue." >&2
  exit 0
fi

cat >&2 <<EOF
[merge-queue] REFUSED: master moves only through the agent-repl merge queue.
[merge-queue] master did not move. Land the work with /agent-repl-merge-queue
[merge-queue] ($SKILL), which merges, runs the test gate and fast-forwards master:
[merge-queue]   - conclude this workspace:      agent-repld workspace merge here -placement back   (it closes once it lands)
[merge-queue]   - land a branch, keep working:  agent-repld workspace async-merge -name <name> -branch <branch> ...
[merge-queue] Committed on master by mistake? Put a branch at the commit
[merge-queue] (\`git branch <name>\`) and land that branch through the skill.
[merge-queue] A refused fast-forward leaves its tree checked out; \`git reset --merge\` puts the checkout back.
[merge-queue] Agents: never set $OWNER_OVERRIDE. It is the owner's alone; a park or a failure is reported, never bypassed.
EOF
exit 1
