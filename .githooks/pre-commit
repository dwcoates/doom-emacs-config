#!/usr/bin/env bash
# pre-commit — enforce the CHEAP static external-boundary lint whenever
# agent-repl source, test, protocol, or local verification files are staged.
#
# THE TEST SUITE IS NO LONGER RUN HERE.  It used to be: every commit that
# staged an agent-repl file ran the whole unified suite
# (modules/app/agent-repl/bin/test-all.sh) before the commit was allowed.
# That gate now lives in the WORKSPACE-MERGE machinery instead —
# daemon/internal/workspace/merge (merge.Driver's per-commit pick loop and
# merge.SuiteRunner) runs the target repository's suite after EVERY
# cherry-picked commit, drives one agent-session resolution attempt at a
# failure, and fails the merge (rolling the target back to its pre-merge
# HEAD) when the failure survives that attempt.  Testing therefore gates
# what lands on the TARGET, not what an agent commits on its own branch.
#
# What remains here is the external-boundary lint: it is grep-only, so it
# costs nothing, and it catches a policy violation at the moment it is
# authored rather than at merge time.
#
# Do not bypass with --no-verify; fix the violations.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Installed by .claude/install.sh into the repo's git hooks dir.  The
# marker string below lets install/uninstall recognize this script as
# managed (so it can be refreshed or removed without touching foreign
# pre-commit hooks).  Don't edit the marker.
# AGENT_REPL_MANAGED_HOOK: agent-repl-precommit
# Legacy marker kept alongside the current one during the
# claude-repl -> agent-repl transition: the installed hook is SHARED
# across worktrees via core.hooksPath, so a pre-rename install.sh (on a
# sibling worktree) must still recognize this copy as managed.
# CLAUDE_REPL_MANAGED_HOOK: claude-repl-precommit
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# An absolute core.hooksPath can be inherited by nested fixture repositories.
# Scope an installed common-dir hook to the repository that owns it, while
# also supporting the documented checkout-local `.githooks` configuration.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
COMMON_DIR="$(git rev-parse --git-common-dir)"
if [[ "$COMMON_DIR" != /* ]]; then
  COMMON_DIR="$REPO_ROOT/$COMMON_DIR"
fi
COMMON_DIR="$(cd "$COMMON_DIR" && pwd -P)"
if [ "$(basename "$HOOK_DIR")" = ".githooks" ]; then
  MANAGED_REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd -P)"
  if [ "$REPO_ROOT" != "$MANAGED_REPO_ROOT" ]; then
    exit 0
  fi
elif [ "$(basename "$HOOK_DIR")" = "hooks" ]; then
  MANAGED_COMMON_DIR="$(cd "$HOOK_DIR/.." && pwd -P)"
  if [ "$COMMON_DIR" != "$MANAGED_COMMON_DIR" ]; then
    exit 0
  fi
fi

# Skip the gate entirely during cherry-picks.  The commit being replayed was
# already linted on its source branch, and workspace merge uses automated
# cherry-picks to land that exact commit — a hook that refused one of them
# would wedge a merge the daemon has no path to un-wedge.
GIT_DIR_PATH="$(git rev-parse --git-dir)"
if [ -f "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ]; then
  echo "[pre-commit] Cherry-pick detected — skipping the agent-repl boundary lint."
  exit 0
fi

# Gate every authored runtime and its local verification infrastructure.  The
# module-name alternation keeps the shared hook valid in older sibling
# worktrees that still carry the pre-rename path.
STAGED_FILES="$(git diff --cached --name-only)"
if ! printf '%s\n' "$STAGED_FILES" | grep -qE \
  '^(modules/app/(agent|claude)-repl/(.*\.(el|go|ts|tsx|proto)|(.*/)?(go\.(mod|sum)|package(-lock)?\.json|tsconfig[^/]*\.json|Makefile)|bin/(test-[^/]+|report-nonlisp-coverage|report-logging-density)\.sh)|\.githooks/(pre-commit|test-pre-commit\.sh))$'; then
  exit 0
fi

# Static lint: no raw external-process invocations outside the wrapper layer.
# See AGENTS.md "No External Processes or External State in Tests".  It is the
# ONLY gate this hook still runs, so a missing or non-executable lint script
# is a hard refusal rather than a quiet skip: a silently ungated commit is
# indistinguishable from a passing one.
BOUNDARY_LINT="$REPO_ROOT/.claude/check-external-boundaries.sh"
if [ ! -x "$BOUNDARY_LINT" ]; then
  echo "[pre-commit] external-boundary lint is missing or not executable: $BOUNDARY_LINT — refusing to commit." >&2
  exit 1
fi

# Run from repo root so the lint sees repository-relative paths.
cd "$REPO_ROOT"

if ! "$BOUNDARY_LINT"; then
  echo "[pre-commit] ✗ external-boundary lint failed — refusing commit." >&2
  echo "[pre-commit] Fix the violations. Do not use --no-verify." >&2
  exit 1
fi

echo "[pre-commit] ✓ agent-repl external-boundary lint passes (the test suite gates at workspace-merge time, not here)."
