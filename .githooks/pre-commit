#!/usr/bin/env bash
# pre-commit — enforce the unified agent-repl test and coverage suite whenever
# agent-repl source, test, protocol, or local verification files are staged.
#
# Per AGENTS.md zero-tolerance rule, ANY failing test blocks the commit.
# Do not bypass with --no-verify; fix the failures.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Installed by .claude/install.sh into the repo's git hooks dir.  The
# marker string below lets install/uninstall recognize this script as
# managed (so it can be refreshed or removed without touching foreign
# pre-commit hooks).  Don't edit the marker.
# AGENT_REPL_MANAGED_HOOK: agent-repl-precommit
# Legacy marker kept alongside the current one during the
# claude-repl -> agent-repl transition: the installed hook is SHARED
# across worktrees via core.hooksPath, so a pre-rename install.sh (on a
# sibling worktree) must still recognize this copy as managed.
# CLAUDE_REPL_MANAGED_HOOK: claude-repl-precommit
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# An absolute core.hooksPath can be inherited by nested fixture repositories.
# Scope an installed common-dir hook to the repository that owns it, while
# also supporting the documented checkout-local `.githooks` configuration.
HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
COMMON_DIR="$(git rev-parse --git-common-dir)"
if [[ "$COMMON_DIR" != /* ]]; then
  COMMON_DIR="$REPO_ROOT/$COMMON_DIR"
fi
COMMON_DIR="$(cd "$COMMON_DIR" && pwd -P)"
if [ "$(basename "$HOOK_DIR")" = ".githooks" ]; then
  MANAGED_REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd -P)"
  if [ "$REPO_ROOT" != "$MANAGED_REPO_ROOT" ]; then
    exit 0
  fi
elif [ "$(basename "$HOOK_DIR")" = "hooks" ]; then
  MANAGED_COMMON_DIR="$(cd "$HOOK_DIR/.." && pwd -P)"
  if [ "$COMMON_DIR" != "$MANAGED_COMMON_DIR" ]; then
    exit 0
  fi
fi

# The module was renamed claude-repl -> agent-repl.  This hook is shared
# across ALL worktrees (core.hooksPath points at the common git dir), and
# sibling worktrees may still carry the old module name — resolve whichever
# module (with its aggregator test file) exists in THIS checkout.
MODULE_NAME=""
for _name in agent-repl claude-repl; do
  if [ -f "$REPO_ROOT/modules/app/$_name/test-$_name.el" ]; then
    MODULE_NAME="$_name"
    break
  fi
done

# Skip the test gate entirely during cherry-picks.  The commit being replayed
# was already tested on its source branch, and workspace merge uses automated
# cherry-picks to land that exact commit.
GIT_DIR_PATH="$(git rev-parse --git-dir)"
if [ -f "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ]; then
  echo "[pre-commit] Cherry-pick detected — skipping unified agent-repl gate."
  exit 0
fi

# Gate every authored runtime and its local verification infrastructure.  The
# module-name alternation keeps the shared hook valid in older sibling
# worktrees that still carry the pre-rename path.
STAGED_FILES="$(git diff --cached --name-only)"
if ! printf '%s\n' "$STAGED_FILES" | grep -qE \
  '^(modules/app/(agent|claude)-repl/(.*\.(el|go|ts|tsx|proto)|(.*/)?(go\.(mod|sum)|package(-lock)?\.json|tsconfig[^/]*\.json|Makefile)|bin/(test-[^/]+|report-nonlisp-coverage|report-logging-density)\.sh)|\.githooks/(pre-commit|test-pre-commit\.sh))$'; then
  exit 0
fi

if [ -z "$MODULE_NAME" ]; then
  echo "[pre-commit] no agent-repl/claude-repl module with an aggregator test file found — refusing to commit." >&2
  exit 1
fi

# Static lint: no raw external-process invocations outside the wrapper
# layer.  See AGENTS.md "No External Processes or External State in
# Tests".  Cheap (grep-only) so we run it before the much slower ERT
# suite — fail fast on policy violations.
BOUNDARY_LINT="$REPO_ROOT/.claude/check-external-boundaries.sh"
if [ -x "$BOUNDARY_LINT" ]; then
  if ! "$BOUNDARY_LINT"; then
    echo "[pre-commit] ✗ external-boundary lint failed — refusing commit." >&2
    exit 1
  fi
fi

UNIFIED_RUNNER="$REPO_ROOT/modules/app/$MODULE_NAME/bin/test-all.sh"
if [ ! -x "$UNIFIED_RUNNER" ]; then
  echo "[pre-commit] unified runner is missing or not executable: $UNIFIED_RUNNER — refusing to commit." >&2
  exit 1
fi

echo "[pre-commit] $MODULE_NAME files staged — running unified tests and coverage..."

# Run from repo root so every suite sees the same repository-relative paths.
cd "$REPO_ROOT"

# Capture output because ERT and Go per-function coverage are intentionally
# verbose.  Print the failure tail, or the concise timing summary on success.
TMP_OUT="$(mktemp -t agent-repl-precommit.XXXXXX)"
trap 'rm -f "$TMP_OUT"' EXIT

if ! "$UNIFIED_RUNNER" >"$TMP_OUT" 2>&1; then
  echo "[pre-commit] ✗ unified agent-repl suite failed — refusing commit." >&2
  echo "[pre-commit] Failure tail:" >&2
  echo "---" >&2
  tail -80 "$TMP_OUT" >&2
  echo "---" >&2
  echo "[pre-commit] Per AGENTS.md zero-tolerance: fix the failures. Do not use --no-verify." >&2
  exit 1
fi

grep -E '^\[agent-repl-tests\] (timing:|all agent-repl tests)' "$TMP_OUT" >&2 || true
echo "[pre-commit] ✓ $MODULE_NAME unified tests and coverage pass."
