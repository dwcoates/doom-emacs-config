#!/usr/bin/env bash
# pre-commit — enforce the agent-repl ERT suite (and the external-boundary
# lint) whenever agent-repl source/test files are staged.
#
# Per AGENTS.md zero-tolerance rule, ANY failing test blocks the commit.
# Do not bypass with --no-verify; fix the failures.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Installed by .claude/install.sh into the repo's git hooks dir.  The
# marker string below lets install/uninstall recognize this script as
# managed (so it can be refreshed or removed without touching foreign
# pre-commit hooks).  Don't edit the marker.
# AGENT_REPL_MANAGED_HOOK: agent-repl-precommit
# Legacy marker kept alongside the current one during the
# claude-repl -> agent-repl transition: the installed hook is SHARED
# across worktrees via core.hooksPath, so a pre-rename install.sh (on a
# sibling worktree) must still recognize this copy as managed.
# CLAUDE_REPL_MANAGED_HOOK: claude-repl-precommit
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# The module was renamed claude-repl -> agent-repl.  This hook is shared
# across ALL worktrees (core.hooksPath points at the common git dir), and
# sibling worktrees may still carry the old module name — resolve whichever
# module (with its aggregator test file) exists in THIS checkout.
MODULE_NAME=""
for _name in agent-repl claude-repl; do
  if [ -f "$REPO_ROOT/modules/app/$_name/test-$_name.el" ]; then
    MODULE_NAME="$_name"
    break
  fi
done

# Skip the test gate entirely during cherry-picks.  The commit being
# replayed was already tested on its source branch; re-running ERT here
# adds noise with no benefit and blocks automated cherry-pick workflows.
GIT_DIR_PATH="$(git rev-parse --git-dir)"
if [ -f "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ]; then
  echo "[pre-commit] Cherry-pick detected — skipping ERT gate."
  exit 0
fi

# Only gate when module source or test files are staged (either module
# name, so the rename commit itself — which stages deletions under the
# old path — is gated too).
if ! git diff --cached --name-only | grep -qE '^modules/app/(agent|claude)-repl/.*\.el$'; then
  exit 0
fi

# Skip the ERT gate on the master branch.  Workspace-merge handling
# replays a workspace's commits onto its source branch via automated
# cherry-picks; for workspaces cut from master those land on master and
# were already tested on the workspace branch, so re-running ERT here
# only adds noise and can block the merge.  The gate exists for normal
# feature-branch commits, so restrict it to non-master branches.
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
if [ "$CURRENT_BRANCH" = "master" ]; then
  echo "[pre-commit] On master branch — skipping ERT gate."
  exit 0
fi

if [ -z "$MODULE_NAME" ]; then
  echo "[pre-commit] no agent-repl/claude-repl module with an aggregator test file found — refusing to commit." >&2
  exit 1
fi

# Static lint: no raw external-process invocations outside the wrapper
# layer.  See AGENTS.md "No External Processes or External State in
# Tests".  Cheap (grep-only) so we run it before the much slower ERT
# suite — fail fast on policy violations.
BOUNDARY_LINT="$REPO_ROOT/.claude/check-external-boundaries.sh"
if [ -x "$BOUNDARY_LINT" ]; then
  if ! "$BOUNDARY_LINT"; then
    echo "[pre-commit] ✗ external-boundary lint failed — refusing commit." >&2
    exit 1
  fi
fi

TEST_FILE="$REPO_ROOT/modules/app/$MODULE_NAME/test-$MODULE_NAME.el"

if [ ! -f "$TEST_FILE" ]; then
  echo "[pre-commit] $TEST_FILE not found — refusing to commit." >&2
  exit 1
fi

echo "[pre-commit] $MODULE_NAME files staged — running ERT suite..."

# Run from repo root so relative `modules/...` paths in test loader resolve.
cd "$REPO_ROOT"

# Capture output to a temp file; only show the failure tail on error
# (full output is enormous because of per-test STUB-CREATE log lines).
TMP_OUT="$(mktemp -t agent-repl-precommit.XXXXXX)"
trap 'rm -f "$TMP_OUT"' EXIT

if ! emacs -batch -Q -l ert \
       -l "modules/app/$MODULE_NAME/test-$MODULE_NAME.el" \
       -f ert-run-tests-batch-and-exit \
       >"$TMP_OUT" 2>&1; then
  echo "[pre-commit] ✗ ERT tests failed — refusing commit." >&2
  echo "[pre-commit] Failure tail:" >&2
  echo "---" >&2
  tail -50 "$TMP_OUT" >&2
  echo "---" >&2
  echo "[pre-commit] Per AGENTS.md zero-tolerance: fix the failures. Do not use --no-verify." >&2
  exit 1
fi

# Trim noise; only print the final summary line.
grep -E "^Ran [0-9]+ tests" "$TMP_OUT" >&2 || true
echo "[pre-commit] ✓ $MODULE_NAME tests pass."
